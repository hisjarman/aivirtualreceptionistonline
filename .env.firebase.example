# Copy these values into your local .env file after registering a Firebase Web App.
# These web app settings identify the Firebase project; never put Admin SDK keys here.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=aivirtualreceptionist-a8a56.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=aivirtualreceptionist-a8a56
VITE_FIREBASE_APP_ID=

# Set to the region selected for Firestore once confirmed; deploy Functions in the
# same/nearest supported region. Do not guess this after creating the Firestore DB.
FIREBASE_FUNCTIONS_REGION=

{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "callpilot-ai",
  "main": "cloudflare/worker.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "containers": [
    {
      "class_name": "CallPilotContainer",
      "image": "./Dockerfile",
      "max_instances": 3
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "CALLPILOT_CONTAINER",
        "class_name": "CallPilotContainer"
      }
    ]
  },
  "exports": {
    "CallPilotContainer": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "observability": {
    "enabled": true
  }
}
